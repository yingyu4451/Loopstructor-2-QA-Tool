{
  "name": "loopstructor-autoplayer-desktop",
  "version": "0.6.89",
  "private": true,
  "description": "Loopstructor 2 QA Tool unified Electron desktop client",
  "author": "yingyu4451",
  "main": "dist-main/main.cjs",
  "type": "module",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && pnpm test:main",
    "test:main": "pnpm build:main && node --test dist-main/updater-relocator.test.cjs dist-main/host-client.test.cjs",
    "start": "pnpm build && electron .",
    "package:dir": "pnpm build && electron-builder --win --dir",
    "package:dir:only": "electron-builder --win --dir",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@iconify-icons/mdi": "2.0.0",
    "@iconify/vue": "5.0.4",
    "gsap": "3.15.0",
    "pinia": "4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "daisyui": "5.7.50",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "21.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "build": {
    "appId": "com.loopstructor.autoplayer.manager",
    "productName": "Loopstructor 2 QA Tool",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asar": true,
    "disableAsarIntegrity": true,
    "asarUnpack": [
      "dist/assets/*.png",
      "dist/assets/*.jpg",
      "dist/assets/*.ttf"
    ],
    "extraMetadata": {
      "shortVersion": "0.6.0",
      "shortVersionWindows": "0.6.0.0"
    },
    "directories": {
      "output": "dist-electron",
      "buildResources": "../assets/branding"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "!dist-main/**/*.test.cjs",
      "!node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../assets/branding/manager-logo-256.png",
        "to": "branding/manager-logo-256.png"
      },
      {
        "from": "../resources/unity-package/com.loopstructor.qa-editor-bridge",
        "to": "unity-package/com.loopstructor.qa-editor-bridge"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "../assets/branding/manager.ico",
      "executableName": "Loopstructor-2-QA-Tool"
    }
  },
  "packageManager": "pnpm@11.28.5"
}
